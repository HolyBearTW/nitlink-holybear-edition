<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../winui/Installer.cs" Link="Installer.cs" />
    <Compile Include="../winui/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../winui/Localization/*.json" LogicalName="NitLinkSetup.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
